; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="1st try RISK"
run/main_scene="res://_0_Game basics/Scenes/MainMenu.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://Scripts/GameManager.gd"
SettingsManager="*res://Scripts/SettingsManager.gd"
ProjectilePool="*res://Scripts/ProjectilePool.gd"
ImpactEffectPool="*res://Scripts/ImpactEffectPool.gd"
BlastEffectPool="*res://Scripts/BlastEffectPool.gd"
UnitGlowEffect="*res://Scripts/UnitGlowEffect.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[input]

toggle_unit_control={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":85,"key_label":0,"unicode":117,"location":0,"echo":false,"script":null)
]
}

[layer_names]

3d_physics/layer_1="Terrain"
3d_physics/layer_2="UnitHitboxes"
3d_physics/layer_3="Projectiles"
