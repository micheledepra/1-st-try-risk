; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="1st try RISK"
run/main_scene="res://_0_Game basics/Scenes/MainMenu.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://Scripts/GameManager.gd"
SettingsManager="*res://Scripts/SettingsManager.gd"
ProjectilePool="*res://Scripts/ProjectilePool.gd"
ImpactEffectPool="*res://Scripts/ImpactEffectPool.gd"
BlastEffectPool="*res://Scripts/BlastEffectPool.gd"
AABlastEffectPool="*res://Scripts/AABlastEffectPool.gd"
AAProjectilePool="*res://Scripts/AAProjectilePool.gd"
UnitGlowEffect="*res://Scripts/UnitGlowEffect.gd"
AirProjectilePool="*res://Scripts/AirProjectilePool.gd"
AirImpactEffectPool="*res://Scripts/AirImpactEffectPool.gd"
AeroUnits="*res://addons/godot_aerodynamic_physics/core/singletons/aero_units.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_aerodynamic_physics/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

